// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String

  profile   Profile?

  features  UserFeature[]
  moods     MoodLog[]
  sleeps    Sleep[]
  progress  DailyProgress[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  weight        Float?
  height        Float?
  birthDate     DateTime?
  activityLevel Int?
  gender        Gender?

  user          User     @relation(fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Feature {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users UserFeature[]
}

model UserFeature {
  id        Int @id @default(autoincrement())

  userId    Int
  featureId Int

  user      User    @relation(fields: [userId], references: [id])
  feature   Feature @relation(fields: [featureId], references: [id])
}

model MoodLog {
  id     Int      @id @default(autoincrement())
  userId Int
  mood   String
  note   String?
  date   DateTime

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  completed Int
  total     Int
  treeLevel Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Sleep {
  id     Int      @id @default(autoincrement())
  userId Int
  user   User     @relation(fields: [userId], references: [id])
  hours  Int
  date   DateTime 

  @@unique([userId, date])  
}
