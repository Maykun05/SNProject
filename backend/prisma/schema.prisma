generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int             @id @default(autoincrement())
  username String
  email    String          @unique
  password String
  progress DailyProgress[]
  moods    MoodLog[]
  profile  Profile?
  sleeps   Sleep[]
  features UserFeature[]
}

model Profile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  weight        Float?
  height        Float?
  birthDate     DateTime?
  activityLevel Int?
  gender        Gender?
  user          User      @relation(fields: [userId], references: [id])
}

model Feature {
  id    Int           @id @default(autoincrement())
  name  String        @unique
  users UserFeature[]
}

model UserFeature {
  id        Int     @id @default(autoincrement())
  userId    Int
  featureId Int
  feature   Feature @relation(fields: [featureId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model MoodLog {
  id     Int      @id @default(autoincrement())
  userId Int
  mood   String
  note   String?
  date   DateTime
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  completed Int
  total     Int
  treeLevel Int
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Sleep {
  id     Int      @id @default(autoincrement())
  userId Int
  hours  Int
  date   DateTime
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
