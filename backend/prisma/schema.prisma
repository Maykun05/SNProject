generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int             @id @default(autoincrement())
  email    String          @unique
  password String
  username String
  
  profile   Profile?
  
  features UserFeature[]
  moods    MoodLog[]
  sleeps   Sleep[]
  progress DailyProgress[]

  missions MissionProgress[]   
  transactions CoinTransaction[]
}

model Profile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  weight        Float?
  height        Float?
  birthDate     DateTime?
  activityLevel Int?
  gender        Gender?

  user          User      @relation(fields: [userId], references: [id])

  coins         Int @default(0)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Feature {
  id    Int           @id @default(autoincrement())
  name  String        @unique

  users UserFeature[]
}

model UserFeature {
  id        Int     @id @default(autoincrement())

  userId    Int
  featureId Int

  user      User    @relation(fields: [userId], references: [id])
  feature   Feature @relation(fields: [featureId], references: [id])
}

model MoodLog {
  id     Int      @id @default(autoincrement())
  userId Int
  mood   String
  note   String?
  date   DateTime

  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  completed Int
  total     Int
  treeLevel Int

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Sleep {
  id     Int      @id @default(autoincrement())
  userId Int
  user   User     @relation(fields: [userId], references: [id])
  hours  Int
  date   DateTime
  

  @@unique([userId, date])
}

model MissionProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  missionId   String    // อ้างอิงจาก ALL_MISSIONS
  type        String    // daily | weekly | monthly
  progress    Int       @default(0)
  goal        Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, missionId]) // ❗ กันซ้ำ
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  source    String   // daily | weekly | monthly
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model MissionReward {
  id     Int    @id @default(autoincrement())
  type   String @unique  // daily / weekly / monthly
  reward Int
}
