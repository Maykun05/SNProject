// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  username     String
  password     String

  profile      Profile?

  coins        Int               @default(0)
  transactions CoinTransaction[]
  progress     DailyProgress[]
  missions     MissionProgress[]
  moods        MoodLog[]
  sleeps       Sleep[]
  features     UserFeature[]
  featureLogs  DailyFeatureLog[]
  stepSessions StepSession[]
  foods        FoodLog[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  weight        Float?
  height        Float?
  birthDate     DateTime?
  activityLevel Int?
  gender        Gender?
  selectedTreeType Int   @default(1)  

  calorieGoal     Int?  
  profileImage    String?

  user          User     @relation(fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Feature {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users UserFeature[]
}

model UserFeature {
  id        Int @id @default(autoincrement())

  userId    Int
  featureId Int

  user      User    @relation(fields: [userId], references: [id])
  feature   Feature @relation(fields: [featureId], references: [id])
}

model MoodLog {
  id     Int      @id @default(autoincrement())
  userId Int
  mood   String
  note   String?
  date   DateTime

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  completed Int
  total     Int
  treeLevel Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyFeatureLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  featureKey String
  logDate    DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, featureKey, logDate])
  @@index([userId, logDate])
}

model Sleep {
  id     Int      @id @default(autoincrement())
  userId Int
  user   User     @relation(fields: [userId], references: [id])
  hours  Float
  date   DateTime 

  @@unique([userId, date])  
}

model MissionProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  missionId   String
  type        String
  progress    Int       @default(0)
  goal        Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, missionId])
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  source    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MissionReward {
  id     Int    @id @default(autoincrement())
  type   String @unique
  reward Int
}

model StepSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  steps     Int
  distance  Float
  calories  Int
  duration  Int
  date      DateTime
  route     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FoodLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  name      String
  calories  Int
  protein   Float?
  carbs     Float?
  fat       Float?

  date      DateTime @default(now())

  @@index([userId, date])
}
