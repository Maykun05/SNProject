// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int               @id @default(autoincrement())
  username     String
  email        String            @unique
  password     String
  coins        Int               @default(0)
  transactions CoinTransaction[]
  progress     DailyProgress[]
  missions     MissionProgress[]
  moods        MoodLog[]
  profile      Profile?
  sleeps       Sleep[]
  features     UserFeature[]
  stepSessions StepSession[]
}

model Profile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  weight        Float?
  height        Float?
  birthDate     DateTime?
  activityLevel Int?
  gender        Gender?
  selectedTreeType Int   @default(1)  

  user          User     @relation(fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Feature {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users UserFeature[]
}

model UserFeature {
  id        Int @id @default(autoincrement())

  userId    Int
  featureId Int

  user      User    @relation(fields: [userId], references: [id])
  feature   Feature @relation(fields: [featureId], references: [id])
}

model MoodLog {
  id     Int      @id @default(autoincrement())
  userId Int
  mood   String
  note   String?
  date   DateTime

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  completed Int
  total     Int
  treeLevel Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Sleep {
  id     Int      @id @default(autoincrement())
  userId Int
  user   User     @relation(fields: [userId], references: [id])
  hours  Int
  date   DateTime 

  @@unique([userId, date])  
}

model MissionProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  missionId   String
  type        String
  progress    Int       @default(0)
  goal        Int
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, missionId])
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  source    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MissionReward {
  id     Int    @id @default(autoincrement())
  type   String @unique
  reward Int
}

model StepSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  steps     Int
  distance  Float
  calories  Int
  duration  Int
  date      DateTime
  route     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
model CalorieLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  calories  Int
  amount    Int
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
